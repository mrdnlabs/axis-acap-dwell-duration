{
    "schemaVersion": "2.2.0",
    "acapPackageConf": {
        "setup": {
            "appName": "object_dwell_timer",
            "friendlyName": "Object Dwell Timer",
            "vendor": "MRDN Labs",
            "vendorUrl": "https://github.com/mrdnlabs",
            "vendorId": "4D52444E4C",
            "runMode": "respawn",
            "version": "0.1.0",
            "architecture": "aarch64",
            "compatibleOsVersions": [
                {
                    "min": "12.11.72",
                    "max": "13"
                }
            ]
        },
        "configuration": {
            "settingPage": "index.html",
            "paramConfig": [
                {
                    "name": "ObjectTypes",
                    "default": "Human,Vehicle,Car,Truck,Bus,Bike,VehicleOther",
                    "type": "string"
                },
                { "name": "MinScore", "default": "0.30", "type": "string" },
                { "name": "FallbackToVehicle", "default": "yes", "type": "bool:no,yes" },
                { "name": "ReferencePoint", "default": "bottomCenter", "type": "string" },
                { "name": "EnterDebounce", "default": "0.5", "type": "string" },
                { "name": "ExitDebounce", "default": "2.0", "type": "string" },
                { "name": "UpdateInterval", "default": "10.0", "type": "string" },
                { "name": "DwellThreshold", "default": "100.0", "type": "string" },
                { "name": "OcclusionMaxGap", "default": "60.0", "type": "string" },
                { "name": "StationaryHold", "default": "300.0", "type": "string" }
            ],
            "reverseProxy": [
                {
                    "apiPath": "status",
                    "target": "http://127.0.0.1:2101",
                    "access": "viewer"
                },
                {
                    "apiPath": "api",
                    "target": "http://127.0.0.1:2101",
                    "access": "admin"
                }
            ]
        }
    },
    "resources": {
        "deviceDataHub": {
            "enabled": true
        }
    }
}
